# Configurações do Ollama Translator
# Copie este arquivo para .env e configure conforme necessário

# Modelo do Ollama a ser usado
# Exemplos: llama3.1, llama3, mistral, gemma2, phi3, qwen2
OLLAMA_MODEL=llama3.1

# Número máximo de requisições simultâneas
# Reduzir este valor se estiver com problemas de memória
OLLAMA_MAX_REQUESTS=5

# Limite de caracteres por requisição (opcional)
# Padrão: 10000
# OLLAMA_CHAR_LIMIT=10000

# Contexto de função customizado (opcional)
# OLLAMA_CONTEXT_FUNCTION="Traduza o texto seguinte. Forneça apenas o texto traduzido, sem comentários adicionais."

# Contexto adicional customizado (opcional)
# OLLAMA_CONTEXT_ADDITIONAL="Atue como um especialista em localização de jogos..."

# ============================================
# CONFIGURAÇÕES DO DEEPL TRANSLATOR
# ============================================
# Chave de API do DeepL (Gratuita ou Pro).
# Contas gratuitas terminam em ':fx' (ex: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx)
# A API gratuita fornece até 500.000 caracteres/mês com tradução neural de altíssima qualidade.
# Obtenha em: https://www.deepl.com/pro-api
DEEPL_API_KEY=

# ============================================
# CONFIGURAÇÕES DO GOOGLE TRANSLATOR & PROXIES
# ============================================
# Ativa ou desativa o pool de proxies rotativos automáticos contra erro 429
# Padrão: true (ou configure no menu interativo ao iniciar)
USE_PROXY_POOL=true
DISABLE_PROXY_POOL=false

# Proxy customizado HTTP/HTTPS próprio ou corporativo (opcional)
# HTTP_PROXY=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080

# Limite de requisições simultâneas ao provedor (opcional)
# TRANSLATE_MAX_CONCURRENT_REQUESTS=4

# ============================================
# COMO USAR A SINOPSE
# ============================================
# A sinopse é fornecida via linha de comando ou modo interativo:
#
# Via linha de comando:
#   python main.py -e "RPG Maker" -t ollamaTranslator -s ja -d pt -i ./game \
#     --synopsis "Sua sinopse aqui"
#
# No modo interativo:
#   python main.py
#   # Será solicitado a inserir a sinopse durante a execução

