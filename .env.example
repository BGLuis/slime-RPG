# ============================================
# CONFIGURAÇÕES DO OLLAMA TRANSLATOR
# ============================================
# Copie este arquivo para .env ou exporte as variáveis no seu ambiente.

# Endpoint HTTP do servidor Ollama local ou remoto
OLLAMA_HOST=http://localhost:11434

# Modelo do Ollama usado na tradução
# Exemplos: qwen2.5, llama3.1, mistral, gemma2
OLLAMA_MODEL=qwen2.5

# Limite de requisições concorrentes ao Ollama
OLLAMA_MAX_REQUESTS=10

# Instrução principal de sistema enviada ao modelo (opcional)
# OLLAMA_CONTEXT_FUNCTION=""

# Instruções adicionais de estilo e preservação de códigos/tags (opcional)
# OLLAMA_CONTEXT_ADDITIONAL=""

# ============================================
# CONFIGURAÇÕES DO DEEPL TRANSLATOR
# ============================================
# Chave da API oficial do DeepL (Free terminada em ':fx' ou Pro).
# Obtenha em: https://www.deepl.com/pro-api
DEEPL_API_KEY=

# ============================================
# CONFIGURAÇÕES DO GOOGLE TRANSLATOR & PROXIES
# ============================================
# Ativa ou desativa o pool automático de proxies rotativos contra erro HTTP 429
USE_PROXY_POOL=true
DISABLE_PROXY_POOL=false

# Proxy HTTP/HTTPS próprio ou corporativo lido pelo runtime Go (opcional)
# HTTP_PROXY=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080

# ============================================
# IDIOMA E CAMINHOS DO SLIME RPG (OPCIONAIS)
# ============================================
# Idioma da interface CLI/TUI/GUI (pt-BR ou en; padrão: idioma do sistema)
# SLIME_LANG=pt-BR

# Sobrescreve os diretórios e bancos SQLite padrão (XDG / AppData)
# SLIME_DATA_DIR=
# SLIME_CONFIG_DIR=
# SLIME_CACHE_DIR=
# SLIME_LOG_DIR=
# SLIME_MEMORY_DB=
# SLIME_SETTINGS_DB=
# SLIME_LOG_FILE=

# ============================================
# COMO USAR A SINOPSE DO JOGO
# ============================================
# Via linha de comando (CLI):
#   slime translate -i ./MeuJogo -t ollama -s ja -d pt --synopsis "Sua sinopse aqui"
#
# Ou diretamente pelas interfaces interativas:
#   slime        # Terminal UI (TUI)
#   slime --gui  # Desktop UI
